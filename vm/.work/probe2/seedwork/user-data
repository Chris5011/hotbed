#cloud-config
instance-id: diag-0001
hostname: probe2
users:
  - name: dev
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEv8CnvLurgIQ7Ad66CtifAVlm5jsweywo5KAkJmerHF sbxvm
ssh_pwauth: false
package_update: false
packages:
  - linux-image-amd64
write_files:
  - path: /etc/systemd/system/workspace.mount
    permissions: '0644'
    content: |
      [Unit]
      Description=9p host workspace share
      [Mount]
      What=hostshare
      Where=/workspace
      Type=9p
      Options=trans=virtio,version=9p2000.L,msize=104857600
      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/sbx-diag.service
    permissions: '0644'
    content: |
      [Unit]
      Description=sbxvm guest network diagnostic dump
      [Service]
      Type=oneshot
      ExecStart=/bin/sh -c 'sleep 25; { ip a; echo ===ROUTE; ip r; echo ===LISTEN; ss -tlnp; echo ===NFT; nft list ruleset 2>&1; echo ===IPT; iptables-save 2>&1; echo ===SSHUNIT; systemctl status ssh.socket ssh.service --no-pager -n 20 2>&1; echo ===JSSH; journalctl -u ssh -u systemd-modules-load --no-pager -n 60 2>&1; } > /workspace/diag.txt 2>&1 || echo "diag: workspace write failed" > /var/log/diag-err'
      [Install]
      WantedBy=multi-user.target
runcmd:
  - mkdir -p /workspace
  - sudo systemctl enable docker 2>/dev/null || true
  - sudo systemctl enable workspace.mount sbx-diag.service
  - sudo systemctl disable cloud-init 2>/dev/null || true
final_message: "DIAG PROVISIONED: $UPTIME seconds"
power_state:
  mode: reboot
  timeout: 60
  condition: "true"
