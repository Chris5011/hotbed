#cloud-config
hostname: probe5
users:
  - name: dev
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEv8CnvLurgIQ7Ad66CtifAVlm5jsweywo5KAkJmerHF sbxvm
ssh_pwauth: false
package_update: true
packages:
  - docker.io
  - build-essential
  - git
  - curl
  - wget
  - jq
  - less
  - unzip
  - ripgrep
  - python3-pip
  - python3-venv
  - pipx
  - ca-certificates
  - tcpdump
  - openssh-server
  - linux-image-amd64
write_files:
  - path: /etc/profile.d/sbxvm-path.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      export GOPATH="$HOME/go"
      export PATH="$GOPATH/bin:$PATH"
  - path: /etc/systemd/system/workspace.mount
    permissions: '0644'
    content: |
      [Unit]
      Description=9p host workspace share (sbxvm)
      [Mount]
      What=hostshare
      Where=/workspace
      Type=9p
      Options=trans=virtio,version=9p2000.L,msize=104857600
      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/sbx-diag.service
    permissions: '0644'
    content: |
      [Unit]
      Description=sbx diag1: full net/socket state snapshot with dockerd up
      After=docker.service
      [Service]
      Type=oneshot
      ExecStart=/bin/sh -c 'sleep 25; exec /usr/bin/sbx-diag1'
      [Install]
      WantedBy=multi-user.target
  - path: /usr/bin/sbx-diag1
    permissions: '0755'
    content: |
      #!/bin/bash
      {
        echo "=== diag1 $(date -Ins) (boot-2, dockerd up, full kernel)"
        echo "--- LOCALPROBE 127.0.0.1:22 (expect SSH-2.0 banner):"
        timeout 5 bash -c 'exec 3<>/dev/tcp/127.0.0.1/22 && head -c 40 <&3' 2>&1 || echo "  LOCAL-PROBE-FAIL rc=$?"
        echo "--- SELFPROBE own-IP 10.0.2.15:22:"
        timeout 5 bash -c 'exec 3<>/dev/tcp/10.0.2.15/22 && head -c 40 <&3' 2>&1 || echo "  SELF-PROBE-FAIL rc=$?"
        echo "--- ss -tlnp:"
        ss -tlnp 2>&1
        echo "--- ss -tan head 30:"
        ss -tan 2>&1 | head -30
        echo "--- ip -br a:"; ip -br a 2>&1
        echo "--- ip r:"; ip r 2>&1
        echo "--- iptables-save:"; iptables-save 2>&1
        echo "--- nft list ruleset (head 80):"; nft list ruleset 2>&1 | head -80
        echo "--- sysctls:"; sysctl net.netfilter.bridge-nf-call-iptables net.ipv4.ip_forward net.ipv4.conf.all.rp_filter 2>&1
        echo "--- nf_conntrack head 40:"; head -40 /proc/net/nf_conntrack 2>&1
        echo "--- ip rule:"; ip rule 2>&1
        echo "--- ssh unit:"; systemctl status ssh --no-pager -n 12 2>&1
        echo "--- sshd procs:"; ps -o pid,ppid,stat,rss,cmd -C sshd 2>&1
        echo "--- dmesg net/netfilter:"; dmesg 2>/dev/null | grep -aiE 'virtio|virtio_net|netfilter|iptables|conntrack|bridge|ens3|e1000' | tail -25
        echo "--- dockerd/containerd state:"; systemctl is-active docker docker.socket containerd 2>&1
        echo "--- outbound:"; timeout 6 getent hosts deb.debian.org || echo DNS-FAIL; timeout 8 curl -sfI https://deb.debian.org >/dev/null && echo OUTBOUND-OK || echo OUTBOUND-FAIL
        echo "--- 9p:"; mount | grep workspace || echo NO-9P-MOUNT; ls -la /workspace 2>&1 | head -5
      } > /var/log/sbx-diag1.txt 2>&1
      cat /var/log/sbx-diag1.txt > /dev/console 2>&1 || true
  - path: /etc/systemd/system/sbx-diag2.service
    permissions: '0644'
    content: |
      [Unit]
      Description=sbx diag2: stop dockerd, restart sshd, re-probe
      After=sbx-diag.service
      [Service]
      Type=oneshot
      ExecStart=/bin/sh -c 'sleep 75; exec /usr/bin/sbx-diag2'
      [Install]
      WantedBy=multi-user.target
  - path: /usr/bin/sbx-diag2
    permissions: '0755'
    content: |
      #!/bin/bash
      echo "=== diag2 $(date -Ins) START tcpdump 200s port22 ens3" > /dev/console 2>&1
      timeout 200 tcpdump -i ens3 -nn -l 'tcp port 22' > /var/log/tcpdump-22-$(date +%s).txt 2>&1 &
      sleep 205
      echo "=== diag2 $(date -Ins) CAPTURE DONE" > /dev/console 2>&1
      pkill -f 'tcpdump -i ens3' 2>/dev/null
runcmd:
  - mkdir -p /workspace /home/dev/go
  - curl -fsSL https://github.com/sst/opencode/releases/download/v1.19.4/opencode-linux-x64.tar.gz | tar -xz -C /usr/local/bin opencode
  - chmod 0755 /usr/local/bin/opencode
  - usermod -aG docker dev
  - systemctl enable docker workspace.mount sbx-diag.service sbx-diag2.service
  - [ "sh", "-c", 'PKGS=$(dpkg -l | awk ''/linux-image-[0-9].*cloud-amd64 / {print $2}''); [ -n "$PKGS" ] && DEBIAN_FRONTEND=noninteractive apt-get purge -y $PKGS' ]
  - systemctl disable cloud-init 2>/dev/null || true
final_message: "PROBE3 PROVISIONED at $UPTIME s — rebooting into full kernel"
power_state:
  mode: reboot
  timeout: 90
  condition: "true"
