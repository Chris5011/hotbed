#!/usr/bin/env bash
# sbx — disposable sandboxed dev containers for AI coding tools (OpenCode etc.)
#
# Any project directory can get its own throwaway Docker sandbox:
#   * project bind-mounted at /workspace  (that dir is the blast radius)
#   * toolchains installed inside die with `sbx rm`
#   * shared package caches (npm/pip/go/cargo volumes) survive for speed
#   * opencode + auth/config mounted in, so the TUI works inside the sandbox
#
# Part of OpenCode-SBX:  https://github.com/chris5011/OpenCode-SBX  (local kit)
#
set -euo pipefail

SBX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SBX_VERSION="0.1.0"
SBX_IMAGE_PREFIX="sbx"
SBX_LABEL="dev.sbx"
SBX_KEY_FALLBACK_VERSIONS=("go:1.24.0")

STACKS="base node python go rust i2cpp"
# bare `sbx build` (no args) — i2cpp stays opt-in there: the mingw-w64
# cross toolchain is a ~500 MB layer most projects never need.
CORE_STACKS="base node python go rust"
DEFAULT_STACK="base"

# --- options -----------------------------------------------------------------
STACK=""
OPT_FRESH=0
OPT_NET=""
OPT_NO_AUTH=0
OPT_NO_OCCONF=0
OPT_NO_GIT=0
OPT_NO_SSH=0
OPT_YES=0
OPT_NO_CACHE=0
EXTRA_MOUNTS=()
EXTRA_ENVS=()

# --- small helpers -----------------------------------------------------------
die()   { printf '\e[31;1msbx: FAIL\e[0m %s\n' "$*" >&2; exit 1; }
warn()  { printf '\e[33;1msbx:\e[0m %s\n' "$*" >&2; }
info()  { printf '\e[36;1msbx:\e[0m %s\n' "$*" >&2; }
ok()    { printf '\e[32;1msbx:\e[0m %s\n' "$*" >&2; }
usage() { printf '%s\n' "$*"; exit 2; }

docker_cli() {
    command -v docker >/dev/null 2>&1 \
        || die "docker CLI not found. (Docker Desktop: enable WSL integration for this distro — Settings → Resources → WSL Integration → kali-linux, then restart Docker Desktop.) Current \$PATH: $PATH"
    printf docker
}
DOCKER="$(docker_cli)"

engine_up() {
    "$DOCKER" info --format '{{.ServerVersion}}' >/dev/null 2>&1
}
require_engine() {
    engine_up || die "docker engine unreachable. Is Docker Desktop running on Windows? (It must be, for sandboxes to work.)"
}

require_project() {
    if [[ "$PWD" == "/workspace" || "$PWD" == /workspace/* ]]; then
        die "you are already inside a sandbox; sbx manages sandboxes from the host side."
    fi
    PROJ_HOST="$(cd -P . && pwd)"
    PROJ_ID="$(printf '%s' "$PROJ_HOST" | sha256sum | cut -c1-8)"
    PROJ_NAME="$(basename "$PROJ_HOST" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._' '-' | sed 's/[-.]*$//')"
}

# resolve stack: explicit --stack wins, else filesystem heuristics
resolve_stack() {
    local want="${STACK:-auto}"
    if [[ "$want" != "auto" ]]; then
        cn_stack="${want}"
        is_stack "$want" || usage "unknown stack '$want' (choose from: $STACKS)"
        return
    fi
    cn_stack="$DEFAULT_STACK"
    if [[ -f go.mod || -f go.work ]]; then
        cn_stack="go"
    elif [[ -f Cargo.toml ]]; then
        cn_stack="rust"
    elif [[ -f package.json ]]; then
        cn_stack="node"
    elif [[ -f pyproject.toml || -f requirements.txt || -f setup.py || -f setup.cfg || -f Pipfile || -f uv.lock ]]; then
        cn_stack="python"
    fi
}
is_stack() {
    case " $STACKS " in
        *" $1 "*) return 0 ;;
        *)        return 1 ;;
    esac
}

image_name()  { printf '%s:%s' "$SBX_IMAGE_PREFIX" "$1"; }
cnname()      { printf 'sbx-%s-%s' "$cn_stack" "$PROJ_ID"; }

image_built() { "$DOCKER" image inspect "$(image_name "$1")" >/dev/null 2>&1; }

ensure_image() {
    local st="$1"
    if image_built "$st"; then
        return
    fi
    info "image sbx:$st not found — building it (one-time per stack, cached in layers)..."
    build_image "$st"
}

build_image() {
    local st="$1"; shift || true
    local args=()
    if [[ -n "${SBX_PLATFORM:-}" ]]; then args+=(--platform "$SBX_PLATFORM"); fi
    if [[ "$OPT_NO_CACHE" == "1" ]]; then args+=(--no-cache); fi
    # recipe provenance: same stamp the daemon's create-time ensure() writes;
    # bin/sbx and sbxd must agree, or the create-time freshness check cries wolf.
    local stamp
    stamp="$(sha256sum "$SBX_ROOT/containers/Dockerfile" 2>/dev/null | awk '{print substr($1,1,8)}')"
    if [[ -n "$stamp" ]]; then args+=(--label "dev.sbx.recipe=$stamp"); fi
    args+=(--target "$st" -t "sbx:$st" -f "$SBX_ROOT/containers/Dockerfile" "$SBX_ROOT")
    require_engine
    "$DOCKER" build "${args[@]}" "$@"
}

build_help() {
    info "building target '$1' into image sbx:$1 ..."
    local t0=$SECONDS
    build_image "$1"
    ok "built sbx:$1 in $(( SECONDS - t0 ))s"
}

# --- Windows bridge (WSL-only, opt-in) ---------------------------------------
# The i2cpp build loop ends on Windows: the built .dll/.exe has to land
# somewhere Windows can see it, get the target launched, logs read back.
# On WSL2 hosts this works through the distro's interop channel. Deliberate
# host-side (not inside sandboxes): containers run in Docker Desktop's own
# utility VM whose kernel intentionally lacks AF_VSOCK — the WSL /init
# interop interpreter cannot reach Windows from there, so no bridge helper
# ships inside stack images. Nothing here touches sandbox boundaries; a
# plain Linux host just gets a loud "not on WSL" instead of a working verb.
WS_DROP_DIR="/mnt/c/Users/Public/sbx-drop"

wsl_interop_ok() {
    grep -aq enabled /proc/sys/fs/binfmt_misc/WSLInterop 2>/dev/null
}

wsl_require() {
    command -v powershell.exe >/dev/null 2>&1 \
        || die "no powershell.exe on PATH — Windows bridge needs a WSL2 distro (PATH includes /mnt/c/Windows/System32 on WSL)."
    wsl_interop_ok \
        || die "WSL interop is disabled (/proc/sys/fs/binfmt_misc/WSLInterop). Fix: set [interop] enabled=true in /etc/wsl.conf as root, then 'wsl --shutdown'."
}

wintest() {
    printf -- '== Windows bridge health ==\n'
    wsl_require \
        && ok "WSL interop reachable (binfmt_misc/WSLInterop enabled)"
    local psout
    psout="$(powershell.exe -NoProfile -Command \
        "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Write-Output ('powershell ' + \$PSVersionTable.PSVersion.ToString() + ' on ' + [Environment]::OSVersion.VersionString)" 2>&1 | tr -d '\r\n')"
    ok "windows answered: $psout"
}

winsh() {
    wsl_require
    local pscmd="$*"
    [[ -n "$pscmd" ]] || usage "winsh needs a powershell command, e.g.: sbx winsh \$PSVersionTable"
    powershell.exe -NoProfile -Command \
        "[Console]::OutputEncoding=[Text.Encoding]::UTF8; $pscmd"
}

windrop() {
    wsl_require
    [[ $# -gt 0 ]] || usage "windrop needs files to copy, e.g.: sbx windrop /workspace/hello.dll"
    mkdir -p "$WS_DROP_DIR" 2>/dev/null \
        || die "cannot create $WS_DROP_DIR — mount C: into this distro first (/etc/wsl.conf [automount] enabled=true)."
    local src dest
    for src in "$@"; do
        [[ -f "$src" ]] || die "windrop: not a regular file: $src"
        cp -f "$src" "$WS_DROP_DIR/" \
            || die "windrop: cannot copy $src into $WS_DROP_DIR"
        dest="$WS_DROP_DIR/$(basename "$src")"
    done
    ok "dropped $# file(s) into $WS_DROP_DIR (visible from Windows at C:\\Users\\Public\\sbx-drop)"
}


# emits one `--flag value` pair per line; caller maps into an array
mounts_and_flags() {
    local st="$cn_stack"

    # project dir (the blast radius)
    require_project
    printf -- '--volume=%s:%s\n' "$PROJ_HOST" /workspace

    # opencode state (auth lives in the sqlite db) — shared with host
    local oc_data="$HOME/.local/share/opencode"
    local oc_conf="$HOME/.config/opencode"
    local    oc_bin="$HOME/.opencode/bin/opencode"
    if [[ "$OPT_NO_AUTH" == "0" ]]; then
        if [[ -d "$oc_data" ]]; then
            printf -- '--volume=%s:%s\n' "$oc_data" /home/sbx/.local/share/opencode
        else
            warn "no $oc_data — inside sandbox, run 'opencode' once to auth (login goes to container-only storage, 'sbx rm' erases it)"
        fi
    fi
    if [[ "$OPT_NO_OCCONF" == "0" && -d "$oc_conf" ]]; then
        printf -- '--volume=%s:%s\n' "$oc_conf" /home/sbx/.config/opencode
    fi
    if [[ "$OPT_NO_AUTH" == "0" && -x "$oc_bin" ]]; then
        printf -- '--volume=%s:%s:ro\n' "$oc_bin" /usr/local/bin/opencode
    fi

    # git identity
    if [[ "$OPT_NO_GIT" == "0" && -f "$HOME/.gitconfig" ]]; then
        printf -- '--volume=%s:%s:ro\n' "$HOME/.gitconfig" /home/sbx/.gitconfig
    fi

    # ssh for git push/pull
    if [[ "$OPT_NO_SSH" == "0" && -d "$HOME/.ssh" ]]; then
        printf -- '--volume=%s:%s:ro\n' "$HOME/.ssh" /home/sbx/.ssh
    fi

    # per-stack persistent caches (named docker volumes)
    case "$st" in
        node)   printf -- '--volume=%s:%s\n' sbx-npm  /home/sbx/.npm ;;
        python) printf -- '--volume=%s:%s\n' sbx-pip  /home/sbx/.cache/pip ;;
        go)     printf -- '--volume=%s:%s\n' sbx-go   /home/sbx/go ;;
        rust)   printf -- '--volume=%s:%s\n' sbx-cargo /usr/local/cargo ;;
    esac

    # user-provided extras
    local m
    for m in "${EXTRA_MOUNTS[@]:-}"; do
        [[ -n "$m" ]] || continue
        printf -- '--volume=%s\n' "$m"
    done
    local e
    for e in "${EXTRA_ENVS[@]:-}"; do
        [[ -n "$e" ]] || continue
        printf -- '--env=%s\n' "$e"
    done
}

run_opts_common() {
    printf -- '--env=SBX_UID=%s\n' "$(id -u)"
    printf -- '--env=SBX_GID=%s\n' "$(id -g)"
    printf -- '--env=SBX_PROJECT=%s\n' "$PROJ_HOST"
    printf -- '--label=%s=1\n' "$SBX_LABEL"
    printf -- '--label=%s.project=%s\n' "$SBX_LABEL" "$PROJ_HOST"
    printf -- '--label=%s.stack=%s\n' "$SBX_LABEL" "$cn_stack"
    printf -- '--workdir=%s\n' /workspace
    if [[ -n "$OPT_NET" ]]; then printf -- '--network=%s\n' "$OPT_NET"; fi
    return 0
}

# tty-aware docker exec env (opencode TUI needs TERM etc.)
exec_env_flags() {
    printf -- '--env=TERM=%s\n' "${TERM:-xterm-256color}"
}

# tty flags for interactive docker runs/execs
tty_flags() {
    printf '%s\n' -i
    if [[ -t 0 && -t 1 ]]; then printf '%s\n' -t; fi
    return 0
}

# --- core actions ------------------------------------------------------------
ensure_container() {
    require_project
    local cn; cn="$(cnname)"
    if "$DOCKER" container inspect "$cn" >/dev/null 2>&1; then
        if [[ "$("$DOCKER" container inspect -f '{{.State.Running}}' "$cn")" != "true" ]]; then
            info "container $cn was stopped — starting it"
            "$DOCKER" container start "$cn" >/dev/null
        fi
        return
    fi
    local opts=() flags=()
    mapfile -t flags < <(mounts_and_flags)
    mapfile -t opts < <(run_opts_common)
    info "creating new sandbox container $cn (stack=$cn_stack)"
    "$DOCKER" container run -d \
        --name "$cn" \
        --restart unless-stopped \
        "${flags[@]}" \
        "${opts[@]}" \
        "$(image_name "$cn_stack")" >/dev/null
}

shell() {
    require_engine
    resolve_stack
    require_project
    ensure_image "$cn_stack"
    if [[ "$OPT_FRESH" == "1" ]]; then
        local flags=() opts=() envs=() ttys=()
        mapfile -t flags < <(mounts_and_flags)
        mapfile -t opts < <(run_opts_common)
        mapfile -t envs < <(exec_env_flags)
        mapfile -t ttys < <(tty_flags)
        info "ephemeral sandbox (--fresh): everything dies when you exit"
        exec "$DOCKER" container run --rm "${ttys[@]}" \
            "${flags[@]}" "${opts[@]}" "${envs[@]}" \
            --workdir /workspace \
            "$(image_name "$cn_stack")" "${@:-bash}"
    fi
    require_project
    ensure_container
    local cn uid gid envs=()
    cn="$(cnname)"; uid="$(id -u)"; gid="$(id -g)"
    mapfile -t envs < <(exec_env_flags)
    ok "entering sandbox $cn (project mounted at /workspace)"
    exec "$DOCKER" exec -it \
        -u "${uid}:${gid}" \
        -w /workspace \
        "${envs[@]}" \
        "$cn" bash
}

exec_in() {
    require_engine
    resolve_stack
    ensure_image "$cn_stack"
    require_project
    if [[ "$OPT_FRESH" == "1" ]]; then die "--fresh does not support exec; use 'sbx exec' for the persistent sandbox or 'sbx --fresh ...' for an ephemeral session."; fi
    ensure_container
    local cn uid gid envs=() ttys=()
    cn="$(cnname)"; uid="$(id -u)"; gid="$(id -g)"
    mapfile -t envs < <(exec_env_flags)
    mapfile -t ttys < <(tty_flags)
    if [[ "${1:-}" == "--" ]]; then shift; fi
    if [[ "$#" -eq 0 ]]; then
        exec "$DOCKER" exec "${ttys[@]}" -u "${uid}:${gid}" -w /workspace "${envs[@]}" "$cn" bash
    fi
    exec "$DOCKER" exec "${ttys[@]}" -u "${uid}:${gid}" -w /workspace "${envs[@]}" "$cn" "$@"
}

root_in() {
    require_engine
    resolve_stack
    ensure_image "$cn_stack"
    require_project
    ensure_container
    local cn; cn="$(cnname)"
    if [[ "${1:-}" == "--" ]]; then shift; fi
    if [[ "$#" -eq 0 ]]; then
        exec "$DOCKER" exec -it -u 0:0 -w /workspace "$cn" bash
    fi
    exec "$DOCKER" exec -u 0:0 -w /workspace "$cn" "$@"
}

opencode() {
    require_engine
    resolve_stack
    ensure_image "$cn_stack"
    if [[ ! -x "$HOME/.opencode/bin/opencode" ]]; then
        warn "host binary $HOME/.opencode/bin/opencode not found — using the baked fallback inside the image (official v1.19.4 channel)"
    fi
    require_project
    ensure_container
    local cn uid gid envs=() flags=() opts=() ttys=()
    cn="$(cnname)"; uid="$(id -u)"; gid="$(id -g)"
    mapfile -t envs < <(exec_env_flags)
    mapfile -t ttys < <(tty_flags)
    if [[ "${1:-}" == "--" ]]; then shift; fi
    if [[ "$OPT_FRESH" == "1" ]]; then
        mapfile -t flags < <(mounts_and_flags)
        mapfile -t opts < <(run_opts_common)
        info "ephemeral opencode run (--fresh)"
        exec "$DOCKER" container run --rm "${ttys[@]}" \
            "${flags[@]}" "${opts[@]}" "${envs[@]}" \
            --workdir /workspace \
            "$(image_name "$cn_stack")" opencode "$@"
    fi
    exec "$DOCKER" exec \
        "${ttys[@]}" \
        -u "${uid}:${gid}" \
        -w /workspace \
        "${envs[@]}" \
        "$cn" opencode "$@"
}

# --- housekeeping ------------------------------------------------------------
list_containers() {
    local FMT='{{.Name}}|{{.State.Status}}|{{index .Config.Labels "dev.sbx.stack"}}|{{index .Config.Labels "dev.sbx.project"}}'
    printf '%-34s %-10s %-10s %s\n' CONTAINER STACK STATE PROJECT
    mapfile -t rows < <("$DOCKER" ps -a --filter "label=${SBX_LABEL}" --format "{{.ID}}")
    for id in "${rows[@]:-}"; do
        [[ -n "$id" ]] || continue
        IFS='|' read -r name status stack project <<< "$("$DOCKER" inspect -f "$FMT" "$id")"
        printf '%-34s %-10s %-10s %s\n' "${name#/}" "$stack" "$status" "${project:-?}"
    done
}

status_current() {
    resolve_stack
    require_project
    local cn; cn="$(cnname)"
    if "$DOCKER" container inspect "$cn" >/dev/null 2>&1; then
        local st; st="$("$DOCKER" inspect -f '{{.State.Status}}' "$cn")"
        ok "current project ($PROJ_HOST, stack=$cn_stack): container $cn [$st]"
    else
        info "current project (stack=$cn_stack): no sandbox yet ('sbx' will create one)"
    fi
}

stop_current() {
    resolve_stack
    require_project
    local cn; cn="$(cnname)"
    "$DOCKER" container inspect "$cn" >/dev/null 2>&1 || die "no sandbox container $cn for this project"
    "$DOCKER" container stop "$cn" >/dev/null && ok "stopped $cn"
}

rm_current() {
    resolve_stack
    require_project
    local cn a; cn="$(cnname)"
    local a
    for a in "$@"; do
        if [[ "$a" == "--yes" || "$a" == "-y" ]]; then OPT_YES=1; fi
    done
    if ! "$DOCKER" container inspect "$cn" >/dev/null 2>&1; then
        info "no sandbox container $cn for this project — nothing to remove"
        return
    fi
    if [[ "$OPT_YES" != "1" ]]; then
        if [[ ! -t 0 ]]; then die "non-interactive session: confirm with 'sbx rm --yes'"; fi
        read -r -p "sbx: remove sandbox '$cn' AND every tool installed inside it? [y/N] " a
        [[ "${a,,}" == "y" || "${a,,}" == "yes" ]] || { info "aborted"; return; }
    fi
    # desktop-aware: `sbxd rm` (when installed) does the full lifecycle —
    # container + proxy keys + wallets + sync target + tmux session. Old
    # sbxd builds (no rm verb) exit non-zero → plain docker path below.
    if command -v sbxd >/dev/null 2>&1 && sbxd rm "$cn" --yes >/dev/null 2>&1; then
        ok "removed $cn (all installs inside it are gone; sbxd keys/wallets/sync cleaned)"
        return
    fi
    "$DOCKER" container rm -f "$cn" >/dev/null && ok "removed $cn (all installs inside it are gone)"
}

prune() {
    require_engine
    local id name a
    for a in "$@"; do
        if [[ "$a" == "--yes" || "$a" == "-y" ]]; then OPT_YES=1; fi
    done
    mapfile -t ids < <("$DOCKER" ps -a --filter "label=${SBX_LABEL}" -q)
    if [[ "${#ids[@]}" -eq 0 || -z "${ids[0]:-}" ]]; then
        ok "no sandbox containers to prune"
        return
    fi
    for id in "${ids[@]}"; do
        name="$("$DOCKER" inspect -f '{{.Name}}' "$id" | sed 's|^/||')"
        remove_one="y"
        if [[ "$OPT_YES" != "1" ]]; then
            if [[ ! -t 0 ]]; then die "non-interactive session: confirm with 'sbx prune --yes'"; fi
            read -r -p "sbx: remove sandbox '$name'? [y/N] " remove_one
        fi
        if [[ "${remove_one,,}" == y* ]]; then
            # sbxd-aware: same full-lifecycle opportunism as `sbx rm`
            if command -v sbxd >/dev/null 2>&1 && sbxd rm "$name" --yes >/dev/null 2>&1; then
                ok "pruned $name"
            else
                "$DOCKER" container rm -f "$id" >/dev/null && ok "pruned $name" || warn "could not prune $name"
            fi
        else
            info "kept $name"
        fi
    done
}

caches() {
    require_engine
    local cmd="${1:-ls}"
    case "$cmd" in
        ls)
            "$DOCKER" volume ls --filter name=^sbx- --format 'table {{.Name}}\t{{.Driver}}'
            ;;
        nuke)
            if [[ "$OPT_YES" != "1" ]]; then
                if [[ ! -t 0 ]]; then die "non-interactive session: confirm with 'sbx caches nuke --yes'"; fi
                read -r -p "sbx: delete ALL sbx-* package cache volumes (npm/pip/go/cargo)? [y/N] " a
                [[ "${a,,}" == y* ]] || { info "aborted"; return; }
            fi
            local v
            mapfile -t vs < <("$DOCKER" volume ls --filter name=^sbx- -q)
            if [[ "${#vs[@]}" -eq 0 || -z "${vs[0]}" ]]; then ok "no cache volumes"; return; fi
            "$DOCKER" volume rm "${vs[@]}" >/dev/null \
                && ok "deleted: ${vs[*]}" \
                || warn "some volumes could not be deleted (in use by a running sandbox?)"
            ;;
        *) usage "unknown caches command '$cmd' (ls|nuke)" ;;
    esac
}

# --- diagnostics -------------------------------------------------------------
doctor() {
    local fail=0

    printf 'OpenCode-SBX doctor\n'
    printf '  version: %s\n' "$SBX_VERSION"

    # engine
    if engine_up; then
        printf '  \e[32m✔\e[0m docker engine up: %s (Docker Desktop)\n' "$("$DOCKER" version --format '{{.Server.Version}}' 2>/dev/null)"
    else
        printf '  \e[31m✘\e[0m docker engine unreachable — start Docker Desktop on Windows)\n'
        fail=1
    fi

    # bind mount smoke test
    if engine_up; then
        local probe=/tmp/opencode/sbx-doctor-probe.$$ hostpath
        rm -rf "$probe"; mkdir -p "$probe"
        if "$DOCKER" run --rm -v "$probe:/probe" alpine:3.21 \
            sh -c 'echo ok > /probe/mnt' >/dev/null 2>&1 \
           && [[ -f "$probe/mnt" ]]; then
            printf '  \e[32m✔\e[0m bind-mount from this distro into containers works\n'
        else
            printf '  \e[31m✘\e[0m bind-mount test failed — Docker Desktop cannot see this distro filesystem\n'
            fail=1
        fi
        rm -rf "$probe"
    fi

    # images
    local st present=()
    for st in $STACKS; do
        if image_built "$st"; then present+=("$st"); fi
    done
    if [[ "${#present[@]}" -gt 0 ]]; then
        printf '  \e[32m✔\e[0m images ready: %s\n' "${present[*]}"
    else
        printf '  \e[33m!\e[0m no sbx images built yet — first "sbx" run builds one automatically\n'
    fi

    # opencode host pieces
    if [[ -x "$HOME/.opencode/bin/opencode" ]]; then
        printf '  \e[32m✔\e[0m host opencode binary found (will be bind-mounted into sandboxes: %s)\n' "$("$HOME/.opencode/bin/opencode" --version 2>/dev/null || echo "?")"
    else
        printf '  \e[33m!\e[0m no host opencode binary — sandboxes fall back to the baked one\n'
    fi
    if [[ -d "$HOME/.local/share/opencode" ]]; then
        printf '  \e[32m✔\e[0m opencode state dir present (auth/session state will be shared)\n'
    else
        printf '  \e[33m!\e[0m no opencode state dir\n'
    fi

    # git / ssh props
    [[ -f "$HOME/.gitconfig" ]] \
        && printf '  \e[32m✔\e[0m ~/.gitconfig will be mounted read-only\n' \
        || printf '  \e[33m!\e[0m ~/.gitconfig missing — commits inside sandbox lack author identity\n'
    [[ -d "$HOME/.ssh" ]] \
        && printf '  \e[32m✔\e[0m ~/.ssh is available read-only inside sandboxes (opt-out: --no-ssh)\n' \
        || printf '  \e[33m!\e[0m ~/.ssh missing — git over ssh inside sandbox will be limited\n'

    # phase-2 vm readiness (informational)
    if [[ -w /dev/kvm ]]; then
        printf '  \e[32m✔\e[0m /dev/kvm usable — sbxvm escape hatch is viable\n'
    else
        printf '  \e[33m!\e[0m /dev/kvm not writable (qemu+libvirt installed?)\n'
    fi

    printf ''
    if [[ $fail -eq 0 ]]; then printf '\e[32;1msbx: all good ✓\e[0m\n'; else exit 1; fi
}

# --- meta --------------------------------------------------------------------
selfinstall() {
    local target="$HOME/.local/bin/sbx"
    if command -v sbx >/dev/null 2>&1 && [[ "$(readlink -f "$(command -v sbx)")" == "$SBX_ROOT/bin/sbx" ]]; then
        ok "already installed at $(command -v sbx)"
        return
    fi
    mkdir -p "$HOME/.local/bin"
    ln -sf "$SBX_ROOT/bin/sbx" "$target"
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) warn "$HOME/.local/bin is not in PATH — add 'export PATH=\"\$HOME/.local/bin:\$PATH\"' to your shell profile."; return ;;
    esac
    ok "installed: $target -> $SBX_ROOT/bin/sbx"
}

help() {
    cat <<EOF
sbx $SBX_VERSION — disposable sandboxed dev containers for AI coding tools

Mental model: 'sbx' makes a throwaway Docker container per project dir.
Your project is bind-mounted at /workspace (project dir = only thing on the
host the agent CAN touch). Everything the agent installs lives only inside
the container and dies with 'sbx rm'.

USAGE: sbx [options] [command] [-- args...]

COMMANDS
  (no args) | shell      shell inside the sandbox for this project
  opencode [args]        run opencode TUI inside the sandbox (-- forwards args)
  exec [--] cmd...       run a single command in the sandbox (tty-aware)
  root [--] cmd...       run as root in the sandbox (e.g. apt-get update)
  status | stop | rm     manage THIS project's sandbox
  ls                     list all sbx sandboxes on the machine
  prune [--yes]          remove all sbx containers
  caches [ls|nuke]       list or wipe the shared package caches
  build [stacks...]      (re)build sbx images
  stack                  print the auto-detected stack for this project
  wintest                Windows bridge: can WSL answer powershell? (diagnose)
  winsh <cmd...>         run a powershell command on the Windows host (WSL only)
  windrop <file...>      copy artifact(s) to C:\\Users\\Public\\sbx-drop (WSL only)
  doctor                 diagnose environment
  version | help         meta

OPTIONS
  --stack NAME           node|python|go|rust|i2cpp|base (default: auto-detect)
  --fresh                ephemeral mode — container is --rm, nondurable
  --net MODE             pass --network MODE to the container (e.g. 'none')
  --no-auth              don't mount host opencode state & binary
  --no-occonf            don't mount host opencode config
  --no-git               don't mount ~/.gitconfig
  --no-ssh               don't mount ~/.ssh
  --mount HOST:CT[:ro]   add extra bind mount (repeatable)
  --env  KEY=VAL         set extra environment var (repeatable)
  --yes                  skip confirmations
EOF
}

version() { printf 'sbx %s\n' "$SBX_VERSION"; }

# --- argument parsing ---------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --stack|-s)    [[ $# -ge 2 ]] || usage "--stack needs a value"; STACK="$2"; shift 2 ;;
        --fresh|-f)    OPT_FRESH=1; shift ;;
        --net)         [[ $# -ge 2 ]] || usage "--net needs a value"; OPT_NET="$2"; shift 2 ;;
        --no-auth)     OPT_NO_AUTH=1; shift ;;
        --no-occonf)   OPT_NO_OCCONF=1; shift ;;
        --no-git)      OPT_NO_GIT=1; shift ;;
        --no-ssh)      OPT_NO_SSH=1; shift ;;
        --yes|-y)      OPT_YES=1; shift ;;
        --no-cache)    OPT_NO_CACHE=1; shift ;;
        --mount)       [[ $# -ge 2 ]] || usage "--mount needs a value"; EXTRA_MOUNTS+=("$2"); shift 2 ;;
        --env|-e)      [[ $# -ge 2 ]] || usage "--env needs a value"; EXTRA_ENVS+=("$2"); shift 2 ;;
        --help|-h)     help; exit 0 ;;
        --version|-V)  version; exit 0 ;;
        --)            if [[ "${CMD_GIVEN:-}" != "1" ]]; then CMD="shell"; fi; shift; break ;;
        -*)            usage "unknown option: $1" ;;
        *)             break ;;
    esac
done

# --- dispatch ------------------------------------------------------------------
CMD="$(if [[ "${CMD:-x}" != "x" ]]; then echo "$CMD"; else echo "${1:-shell}"; fi)"
if [[ $# -gt 0 ]]; then shift; fi

case "$CMD" in
    shell)         shell "$@" ;;
    opencode|oc)   opencode "$@" ;;
    exec)          exec_in "$@" ;;
    root)          root_in "$@" ;;
    stack)         resolve_stack; echo "$cn_stack" ;;
    status)        status_current ;;
    stop)          stop_current ;;
    rm)            rm_current "$@" ;;
    ls|ps)         list_containers ;;
    prune)         prune "$@" ;;
    caches)        caches "$@" ;;
    wintest)       wintest ;;
    winsh)         winsh "$@" ;;
    windrop)       windrop "$@" ;;
    build)         require_engine
                   if [[ $# -eq 0 ]]; then set -- $CORE_STACKS; fi
                   for s in "$@"; do is_stack "$s" || usage "unknown stack '$s'"; done
                   for s in "$@"; do build_help "$s"; done ;;
    doctor)        doctor ;;
    install-self)  selfinstall ;;
    version|v)     version ;;
    help)          help ;;
    *)             help; usage "unknown command '$CMD'" ;;
esac
